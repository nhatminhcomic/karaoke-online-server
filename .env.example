# Sao chep file nay thanh .env roi dien key that cua ban.
# KHONG commit file .env len git, KHONG gui .env cho ai.

# Cong mac server chay (mac dinh 3000)
PORT=3000

# --- YouTube Data API v3 (BAT BUOC de tim bai hat) ---
# Lay key tai https://console.cloud.google.com/apis/credentials
# Bat YouTube Data API v3 trong thu vien API. Neu de trong, chuc nang
# tim kiem se bao loi ro rang, nhung phong van chay, dan link YouTube
# truc tiep de them bai van duoc.
YOUTUBE_API_KEY=

# --- LiveKit Cloud (TUY CHON, de bat mic/voice) ---
# Dang ky tai https://cloud.livekit.io roi lay URL + API key + secret.
# Neu de trong ca 3, server van chay binh thuong, chi co mic bi tat
# (client se bao ro "Voice chua bat"), video/chat/hang cho van chay.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- TURN (TUY CHON, giup mic chay qua NAT/firewall kho) ---
# Neu LiveKit Cloud cua ban da co TURN thi khong can dien.
# Vi du: TURN_URL=turn:turn.example.com:3478
TURN_URL=
TURN_USER=
TURN_PASS=
